<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: the capture service is exported so the energy harness / e2e script can drive it with
  `adb shell am start-foreground-service -n ai.recall/.service.CaptureService -a ai.recall.START ...`.
  It is guarded by android.permission.DUMP, which the adb shell holds but ordinary apps cannot obtain.
  Release builds keep the service unexported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service
            android:name=".service.CaptureService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported"
            tools:ignore="ExportedService,ProtectedPermissions" />
    </application>
</manifest>
